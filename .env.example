# FormSubmit inbox that receives every order the second the checkout form is
# submitted (silent lead capture). Set this in the Vercel dashboard
# (Settings -> Environment Variables -> Production) then redeploy.
# On the first submission FormSubmit sends an activation email to this
# address — click it once or no emails will be delivered.
FORMSUBMIT_EMAIL=

# Optional: secondary webhook (Google Apps Script / Zapier / Make) that also
# receives each order (e.g. to write into a Google Sheet or CRM).
ORDERS_WEBHOOK_URL=

# ---- Meta Conversions API (CAPI) ----
# IMPORTANT: You only use Facebook ads, so this makes your pixel hold up
# against iOS 14.5+/ATT and ad-blockers (which drop ~30-60% of conversions).
# These are sent server-side from /api/order/route.ts on every order.
META_PIXEL_ID=
# Long-lived access token from Meta Business Manager (Settings -> Business
# -> API Access -> Generate token, permissions: ads_read, business_management)
META_ACCESS_TOKEN=
# Provided automatically by Meta; used to like/untest events. Optional.
META_TEST_EVENT_CODE=
